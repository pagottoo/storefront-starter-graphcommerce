# ── Auto-injected by MageScale platform (do not set in Actions/vars) ────────
# MAGENTO_BASE_URL      = https://<store>.magescale.cloud
# MAGENTO_GRAPHQL_URL   = https://<store>.magescale.cloud/graphql
# MAGENTO_REST_URL      = https://<store>.magescale.cloud/rest
# PORT                  = 3000

# ── Client-configured via GitHub → Repository variables (build-time) ────────
GC_MAGENTO_ENDPOINT=https://<store>.magescale.cloud/graphql
GC_MAGENTO_VERSION=247
GC_CANONICAL_BASE_URL=https://storefront.example.com
GC_HYGRAPH_ENDPOINT=https://<region>.cdn.hygraph.com/content/<project>/master
GC_STOREFRONT_0_LOCALE=en
GC_STOREFRONT_0_MAGENTO_STORE_CODE=default
GC_STOREFRONT_0_DEFAULT_LOCALE=true

# ── Runtime-only client secrets (set in MageScale Console → Storefront → Env vars) ─
# GC_GOOGLE_ANALYTICS_ID=
# GC_GOOGLE_RECAPTCHA_KEY=
# NEXT_PUBLIC_*=  (client-side vars visible in browser)

# ── GitHub Actions secrets (Settings → Secrets and variables → Actions) ─────
# DOCKERHUB_USERNAME      = <your Docker Hub username>
# DOCKERHUB_TOKEN         = <Docker Hub PAT with Read/Write on the target repo>
# MAGESCALE_WEBHOOK_URL   = https://api.magescale.cloud/v1/webhooks/storefront/<env_id>
# MAGESCALE_WEBHOOK_TOKEN = <token from Console → Storefront → Deploy token>

# ── Optional Actions variable ───────────────────────────────────────────────
# DOCKERHUB_IMAGE = custom-org/custom-name   # default: <DOCKERHUB_USERNAME>/storefront-starter-graphcommerce
